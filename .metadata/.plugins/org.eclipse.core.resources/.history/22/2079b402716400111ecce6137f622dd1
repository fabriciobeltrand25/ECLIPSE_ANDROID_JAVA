<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText 
        android:id="@+id/etCapital" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:hint="Capital" 
        android:inputType="numberDecimal"/>
    
    <EditText 
        android:id="@+id/etInteres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Interes"
        android:inputType="number"/>
    
    <EditText android:id="@+id/etPlazo" 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Plazo en años"
        android:inputType="number"/>
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <Button
             android:id="@+id/btnCalcular" 
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Calcular"/>
        
        <Button 
            android:id="@+id/btnLimpiar" 
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" 
            android:text="Limpiar"/>
    </LinearLayout>
    

</LinearLayout>